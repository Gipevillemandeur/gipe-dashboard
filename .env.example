# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret. NEVER expose this in client code or GitHub with a real value.
SUPABASE_SECRET_KEY=

# Current school year used by the dashboard before the first import.
NEXT_PUBLIC_DEFAULT_SCHOOL_YEAR=2026-2027
